# Required
OPENAI_API_KEY=sk-...

# Optional — enables live web search
TAVILY_API_KEY=tvly-...

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

# LLM response caching — set false to disable (default: true)
# Same address + same inputs returns cached results without calling the API.
LLM_CACHE_ENABLED=true
LLM_CACHE_DB=.langchain_cache.db
