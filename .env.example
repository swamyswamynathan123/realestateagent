# ── Required ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional — live web search (Tavily) ────────────────────────────────────────
# Enables real-time property listing and market data via web search.
# Free tier at https://tavily.com
TAVILY_API_KEY=tvly-...

# ── Free real data sources (highly recommended) ────────────────────────────────
# Each key is optional but significantly improves accuracy for the listed tool.

# FRED API (Federal Reserve Bank of St. Louis)
# → Real current 30yr/15yr mortgage rates from Freddie Mac weekly survey
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# US Census Bureau ACS API
# → Median home values, household income, population by ZIP code
# Free key (optional — works without key at lower rate limit):
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# HUD Fair Market Rents API
# → Official government rental benchmarks by ZIP code (0BR–4BR)
# Free token: https://www.huduser.gov/hudapi/public/register.php
HUD_API_KEY=

# Walk Score API
# → Real walkability, transit, and bike scores (5,000 req/day free)
# Free key: https://www.walkscore.com/professional/api.php
WALKSCORE_API_KEY=

# Note: FEMA flood zone data (NFHL) is fetched without any key.

# ── Optional LLM overrides ─────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

# ── LLM response caching ───────────────────────────────────────────────────────
# Caches LLM responses so re-running the same address skips the API entirely.
# Disable with LLM_CACHE_ENABLED=false.
LLM_CACHE_ENABLED=true
LLM_CACHE_DB=.langchain_cache.db
